---
const studioUrl = 'https://nebulab-customs.vercel.app/';

const steps = [
  {
    number: '01',
    title: 'Elige tu producto',
    description: 'Explora litofanías, collares para mascotas y clickers o llaveros.',
  },
  {
    number: '02',
    title: 'Sube y personaliza',
    description: 'Carga tu imagen y ajusta forma, colores, tamaño o texto.',
  },
  {
    number: '03',
    title: 'Revisa y pide',
    description: 'Visualiza tu diseño y coordina tu pedido online.',
  },
];
---

<section id="studio" class="relative scroll-mt-20 overflow-hidden bg-[#091426] px-6 py-24 text-white dark:bg-[#070d19]">
  <!-- Digital light field -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-70"
       style="background-image: radial-gradient(circle at 16% 20%, rgba(2,122,195,0.28), transparent 28%), radial-gradient(circle at 86% 72%, rgba(132,70,194,0.3), transparent 32%);">
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-40"
       style="background-image: linear-gradient(rgba(56,189,248,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(56,189,248,0.08) 1px, transparent 1px); background-size: 42px 42px;">
  </div>

  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
      <!-- Copy -->
      <div class="reveal">
        <div class="mb-5 flex items-center gap-3">
          <span class="h-px w-10 bg-neb-cyan"></span>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.28em] text-sky-300">Nebulab Studio · personalización 3D</span>
        </div>

        <h2 class="font-makoto text-4xl font-black leading-[1.08] md:text-6xl">
          PERSONALIZA TU
          <span class="block text-sky-300">PRODUCTO 3D</span>
          <span class="block text-white/80">EN NEBULAB STUDIO</span>
        </h2>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-300 md:text-lg">
          Desde litofanías 3D y collares para mascotas hasta clickers y llaveros, explora tus opciones,
          sube una imagen y convierte tu idea en un producto personalizado.
        </p>

        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a href={studioUrl}
             target="_blank"
             rel="noopener noreferrer"
             class="inline-flex w-full cursor-pointer items-center justify-center gap-3 bg-sky-300 px-7 py-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-[#071321] transition-all duration-200 hover:-translate-y-1 hover:bg-sky-200 hover:shadow-[0_10px_32px_rgba(56,189,248,0.28)] sm:w-auto"
             style="clip-path: polygon(8px 0%, 100% 0%, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0% 100%, 0% 8px);">
            ABRIR NEBULAB STUDIO
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M7 7h10v10" />
            </svg>
          </a>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-500">Explora y personaliza online</span>
        </div>
      </div>

      <!-- Tool preview -->
      <div class="reveal" style="transition-delay: 120ms">
        <div class="relative border border-sky-300/25 bg-white/[0.04] p-3 shadow-[0_0_60px_rgba(2,122,195,0.13)]">
          <div class="mb-3 flex items-center justify-between border-b border-white/10 px-2 pb-3 font-mono text-[9px] uppercase tracking-[0.18em] text-slate-500">
            <span class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-sky-300 shadow-[0_0_10px_rgba(125,211,252,0.8)]"></span>
              STUDIO / 3D
            </span>
            <span>ONLINE</span>
          </div>

          <div class="relative aspect-[4/3] overflow-hidden bg-[#101d31]">
            <img src="/images/lamparas/lampara-04.jpg"
                 alt="Litofanía 3D iluminada de Nebulab Studio"
                 loading="lazy"
                 decoding="async"
                 class="h-full w-full object-cover opacity-55 mix-blend-screen grayscale transition duration-500 hover:scale-105 hover:opacity-70" />
            <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-tr from-[#071321] via-transparent to-sky-300/10"></div>
            <div aria-hidden="true" class="absolute inset-0 opacity-40"
                 style="background: repeating-linear-gradient(0deg, transparent, transparent 5px, rgba(125,211,252,0.08) 5px, rgba(125,211,252,0.08) 6px);"></div>

            <div class="absolute left-4 top-4 border border-sky-300/40 bg-[#071321]/75 px-3 py-2 font-mono text-[9px] uppercase tracking-[0.18em] text-sky-200 backdrop-blur-sm">
              IDEA → PIEZA
            </div>
            <div class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3">
              <div>
                <p class="font-mono text-[9px] uppercase tracking-[0.22em] text-sky-200/70">PREVIEW OUTPUT</p>
                <p class="mt-1 font-makoto text-xl font-black text-white">TU IDEA EN 3D</p>
              </div>
              <div class="flex h-9 w-9 shrink-0 items-center justify-center border border-sky-300/50 text-sky-200">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4" />
                  <circle cx="12" cy="12" r="8" />
                </svg>
              </div>
            </div>
          </div>

          <div class="mt-3 flex items-center justify-between px-2 font-mono text-[9px] uppercase tracking-[0.15em] text-slate-500">
            <span>nebulab-studio</span>
            <span class="text-sky-300/80">ready to customize_</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Process strip -->
    <div class="mt-14 grid gap-px border border-sky-300/15 bg-sky-300/15 sm:grid-cols-3">
      {steps.map((step) => (
        <div class="bg-[#0d1b2f]/90 p-5 transition-colors duration-200 hover:bg-[#122642]">
          <div class="mb-3 flex items-center justify-between">
            <span class="font-makoto text-2xl font-black text-sky-300/70">{step.number}</span>
            <span class="h-px w-10 bg-sky-300/30"></span>
          </div>
          <h3 class="font-mono text-sm font-bold uppercase tracking-wide text-white">{step.title}</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-400">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
